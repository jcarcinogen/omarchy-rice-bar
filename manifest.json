{
  "schemaVersion": 1,
  "id": "io.github.jcarcinogen.rice-bar",
  "name": "Rice Bar",
  "version": "0.5.0",
  "author": "Scott Angel",
  "license": "MIT",
  "description": "A live style gallery for the stock Omarchy bar: 15 choices including Glass, Pixel, Bevel, and Ribbon. Customize each style, save and share looks, and follow your theme palette while keeping the native widgets and panels. Passive decoration inside the existing bar window—not a replacement shell.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Rice Bar",
    "description": "Choose stock-preserving visual treatments for the Omarchy bar",
    "category": "Appearance",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "preset": "islands",
      "opacity": 92,
      "radius": 12,
      "gap": 4,
      "border": true,
      "reducedMotion": true,
      "showIcon": true,
      "themeFollow": false
    },
    "schema": [
      {
        "key": "preset",
        "type": "enum",
        "label": "Style",
        "options": [
          "Omarchy",
          "Islands",
          "Pills",
          "Material",
          "Outline",
          "Rail",
          "Bracket",
          "Glow",
          "Powerline",
          "Mono",
          "Minimal",
          "Glass",
          "Pixel",
          "Bevel",
          "Ribbon"
        ],
        "defaultValue": "Islands",
        "description": "Omarchy restores the unmodified stock bar. Other styles draw passive theme-aware chrome behind its stock widgets."
      },
      {
        "key": "opacity",
        "type": "integer",
        "label": "Surface opacity (%)",
        "min": 20,
        "max": 100,
        "step": 2,
        "defaultValue": 92
      },
      {
        "key": "radius",
        "type": "integer",
        "label": "Corner radius (px)",
        "min": 0,
        "max": 24,
        "step": 1,
        "defaultValue": 12
      },
      {
        "key": "gap",
        "type": "integer",
        "label": "Surface breathing room (px)",
        "min": 0,
        "max": 24,
        "step": 1,
        "defaultValue": 4
      },
      {
        "key": "border",
        "type": "boolean",
        "label": "Accent border",
        "defaultValue": true
      },
      {
        "key": "reducedMotion",
        "type": "boolean",
        "label": "Reduced motion",
        "defaultValue": true
      },
      {
        "key": "showIcon",
        "type": "boolean",
        "label": "Show rice bowl icon",
        "defaultValue": true
      },
      {
        "key": "themeFollow",
        "type": "boolean",
        "label": "Follow linked theme palettes",
        "defaultValue": false
      }
    ]
  }
}
